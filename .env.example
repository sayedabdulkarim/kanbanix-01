# Copy this file to client/.env.local and fill in your actual values

# Database - using the backend folder's database
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# GitHub OAuth - You need to create these on GitHub
# Go to: https://github.com/settings/developers
# Create a new OAuth App with:
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub Webhook (optional - will be auto-generated if not provided)
GITHUB_WEBHOOK_SECRET=optional-webhook-secret

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kanbanix

# Anthropic AI Configuration
# For DEVELOPMENT: Not needed - uses Claude Desktop via MCP (FREE)
# For PRODUCTION: Required - uses Anthropic API (PAID)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# MCP Configuration
MCP_ENABLED=true
MCP_SERVER_PATH=../mcp-server
MCP_TIMEOUT=120000
# MCP_MODE controls LLM usage:
# - desktop: Uses Claude Desktop locally (FREE, for development)
# - api: Uses Anthropic API (PAID, for production)
MCP_MODE=desktop